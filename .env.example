# .env.example — copy to .env and fill in

# LLM
GROQ_API_KEY=your-groq-api-key-here

# STT
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# TTS
CARTESIA_API_KEY=your-cartesia-api-key-here
CARTESIA_VOICE_ID=your-cartesia-voice-id-here  # default: Helpful Woman

# Call transport
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key-here
LIVEKIT_API_SECRET=your-livekit-api-secret-here

# RAG / Embeddings
HF_MODEL_NAME=BAAI/bge-small-en-v1.5
PINECONE_API_KEY=                # prod only
PINECONE_INDEX_NAME=car-dealer

# Google Calendar OAuth
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
GOOGLE_CALENDAR_ID=primary

# Email (Gmail via OAuth2 — no API key needed, uses token.json)
GMAIL_SENDER_EMAIL=your-email@gmail.com
DEALERSHIP_EMAIL=dealership@gmail.com

# Scheduler
REDIS_URL=redis://localhost:6379/0

# Agent identity
DEALERSHIP_NAME=Premier Auto Dealership
AGENT_NAME=Alex

# Timezone (IANA name — used for slot generation and reminder scheduling)
TIMEZONE=UTC  # e.g. Asia/Karachi, America/New_York

# App
APP_ENV=development
LOG_LEVEL=INFO
